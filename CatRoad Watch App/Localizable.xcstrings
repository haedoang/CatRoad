    "Spin the Crown\nto move your cat!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drehe die Krone,\num deine Katze zu bewegen!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Gira la Corona\npara mover tu gato!"
